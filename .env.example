APP_ENV=development
APP_ORIGIN=http://127.0.0.1:5173
APP_TIMEZONE=Asia/Manila
POSTGRES_DB=learnsync_v2
POSTGRES_USER=learnsync_v2
POSTGRES_PASSWORD=replace-with-a-local-secret
DATABASE_URL=postgresql+psycopg://learnsync_v2:replace-with-a-local-secret@127.0.0.1:15432/learnsync_v2
TEST_DATABASE_URL=postgresql+psycopg://learnsync_v2:replace-with-a-local-secret@127.0.0.1:15432/learnsync_v2_test
SESSION_COOKIE_NAME=learnsync_v2_session
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=43200
SESSION_IDLE_TIMEOUT_SECONDS=1800
INVITATION_TTL_SECONDS=172800
RESET_TTL_SECONDS=1800
SMTP_HOST=127.0.0.1
SMTP_PORT=11025
SMTP_USE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=learnsync@example.test
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_QUIZ_MODEL=openai/gpt-oss-20b
AI_TIMEOUT_SECONDS=45
UPLOAD_MAX_BYTES=20971520

# Development only: 'fake' uses a built-in simulator instead of Groq (never in production).
AI_PROVIDER_MODE=groq

# Optional (defaults shown). Study-help messages per student per minute, and a custom private upload folder.
AI_MESSAGES_PER_MINUTE=10
# UPLOAD_ROOT=var/uploads

# Optional: extra folders no backup/restore script may ever write into (semicolon-separated). The old v1 project is always protected.
# PROTECTED_PATHS=
